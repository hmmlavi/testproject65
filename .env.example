# GOJO configuration
# 1) Copy this file to .env            (in cmd:  copy .env.example .env)
# 2) Paste your free Google AI Studio key on the GEMINI_API_KEY line
#
# SECURITY: never share your .env file, and never paste API keys into
# chats, screenshots, or public sites.

# FREE key: https://aistudio.google.com  ->  "Get API key"  ->  "Create API key"
GEMINI_API_KEY=paste-your-key-here

# Brain model. Leave as-is unless you're told otherwise.
# (If Google renames models later, this is the one line to change.)
GEMINI_MODEL=gemini-2.5-flash

# Which brain to use:
#   gemini = the real GOJO (needs GEMINI_API_KEY)
#   mock   = offline wiring test ONLY (not a real AI)
GOJO_PROVIDER=gemini
