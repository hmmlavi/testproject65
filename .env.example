# GOJO configuration
# 1) Copy this file to .env            (in cmd:  copy .env.example .env)
# 2) Paste your free Google AI Studio key on the GEMINI_API_KEY line
# 3) (for the Fish voice) paste your free Fish Audio key on FISH_AUDIO_API_KEY
#
# SECURITY: never share your .env file, and never paste API keys into
# chats, screenshots, or public sites.

# FREE key: https://aistudio.google.com  ->  "Get API key"  ->  "Create API key"
GEMINI_API_KEY=paste-your-key-here

# Brain model. Leave as-is unless you're told otherwise.
# (If Google renames models later, this is the one line to change.)
GEMINI_MODEL=gemini-2.5-flash

# Which brain to use:
#   gemini = the real GOJO (needs GEMINI_API_KEY)
#   mock   = offline wiring test ONLY (not a real AI)
GOJO_PROVIDER=gemini

# ---------------------------------------------------------------------
# Voice (Phase 3)
# ---------------------------------------------------------------------

# Master switch: false = voice completely off (text chat only)
GOJO_VOICE_ENABLED=true

# Speak GOJO's reply out loud after a voice turn (off = text reply only)
GOJO_TTS_AUTOPLAY=true

# Voice engine:
#   auto    = Fish first, Windows local voice as automatic backup
#   fish    = Fish first (still falls back if it fails — never crashes)
#   windows = fully local/offline, no Fish calls at all
# Can also be changed live in the settings panel (saved in data/gojo_prefs.json).
GOJO_TTS_PROVIDER=auto

# FREE key: https://fish.audio  ->  create account  ->  API key
# Keep it here only — never in chat, code, or commits.
FISH_AUDIO_API_KEY=paste-your-fish-key-here

# Your Gojo voice model on Fish Audio (the "reference" voice model ID).
# Already your model; change only if you create a new one.
FISH_AUDIO_MODEL_ID=0a7bf4b832b2459eb012547b4e3643d3

# Model string sent to the Fish API (goes in the "model" HTTP header).
# s2.1-pro-free = the free tier (current docs default).
FISH_AUDIO_MODEL=s2.1-pro-free

# Speech-to-text model size (faster-whisper, runs on CPU):
#   tiny = fastest, least accurate (~75 MB)
#   base = fast (~145 MB)
#   small = best balance for Hindi/English on a CPU (~460 MB)  <- default
GOJO_STT_MODEL=small

# STT language: EMPTY = auto-detect (best for Hinglish — recommended).
# If `python -m gojo.voice.doctor --diagnose` shows one explicit language
# clearly beats the others for your speech, pin it here:
#   GOJO_STT_LANGUAGE=hi     (Hindi)
#   GOJO_STT_LANGUAGE=en     (English)
GOJO_STT_LANGUAGE=

# Microphone input device.
#   EMPTY = the system's DEFAULT input device.
# If GOJO can't hear you — e.g. your phone mic comes in through AudioRelay
# (a VIRTUAL cable device that is NOT the system default) — do this once:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
# then set GOJO_MIC_DEVICE to that device's NAME or INDEX, e.g.:
#   GOJO_MIC_DEVICE=CABLE 01 (AudioRelay)
#   GOJO_MIC_DEVICE=2
# The Settings panel (Voice -> Mic + Test button) shows which device GOJO
# actually uses and whether samples are arriving.
GOJO_MIC_DEVICE=
